# ═══════════════════════════════════════════════════════════════════════════════
# GRAND SOUL KERNEL — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
# Servers with missing keys will be skipped gracefully.
# ═══════════════════════════════════════════════════════════════════════════════

# ── AI ──────────────────────────────────────────────────────────────────────────
HF_TOKEN=                     # HuggingFace API token
OPENAI_API_KEY=               # OpenAI API key
ANTHROPIC_API_KEY=            # Anthropic/Claude API key
SD_API_URL=                   # Stable Diffusion API URL

# ── Cloud ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=            # AWS access key
AWS_SECRET_ACCESS_KEY=        # AWS secret key
AWS_REGION=us-east-1          # AWS region
VERCEL_TOKEN=                 # Vercel API token
CLOUDFLARE_API_TOKEN=         # Cloudflare API token
KUBECONFIG=                   # Kubernetes config path

# ── Code ─────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                 # GitHub personal access token (repo scope)
GITLAB_TOKEN=                 # GitLab personal access token

# ── Communication ────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=              # Slack bot token (xoxb-...)
SLACK_SIGNING_SECRET=         # Slack signing secret
SLACK_TEAM_ID=                # Slack team/workspace ID
DISCORD_BOT_TOKEN=            # Discord bot token
TELEGRAM_BOT_TOKEN=           # Telegram bot token
EMAIL_SMTP_HOST=              # SMTP server host
EMAIL_SMTP_PORT=587           # SMTP server port
EMAIL_USER=                   # SMTP username
EMAIL_PASS=                   # SMTP password

# ── Core ─────────────────────────────────────────────────────────────────────────
SEARCH_API_KEY=               # Brave Search API key (optional, fetch works without it)

# ── Creative ─────────────────────────────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=           # Figma personal access token
CANVA_API_KEY=                # Canva API key
UNSPLASH_ACCESS_KEY=          # Unsplash API access key
YOUTUBE_API_KEY=              # YouTube Data API key
VIMEO_ACCESS_TOKEN=           # Vimeo API token

# ── Database ─────────────────────────────────────────────────────────────────────
PG_CONNECTION_STRING=         # PostgreSQL: postgresql://user:pass@host:5432/db
MYSQL_CONNECTION_STRING=      # MySQL: mysql://user:pass@host:3306/db
MONGODB_CONNECTION_STRING=    # MongoDB: mongodb://user:pass@host:27017/db
REDIS_URL=                    # Redis: redis://user:pass@host:6379
ES_URL=                       # Elasticsearch URL
ES_API_KEY=                   # Elasticsearch API key

# ── Finance ──────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # Stripe secret key (sk_...)
COINBASE_API_KEY=             # Coinbase API key
COINBASE_API_SECRET=          # Coinbase API secret
PLAID_CLIENT_ID=              # Plaid client ID
PLAID_SECRET=                 # Plaid secret
PLAID_ENV=sandbox             # Plaid environment (sandbox, development, production)

# ── Monitoring ───────────────────────────────────────────────────────────────────
PROMETHEUS_URL=               # Prometheus server URL
GRAFANA_URL=                  # Grafana server URL
GRAFANA_API_KEY=              # Grafana API key
SENTRY_DSN=                   # Sentry DSN
SENTRY_TOKEN=                 # Sentry auth token
DATADOG_API_KEY=              # Datadog API key
DATADOG_APP_KEY=              # Datadog application key
PAGERDUTY_API_KEY=            # PagerDuty API token

# ── Productivity ─────────────────────────────────────────────────────────────────
NOTION_API_KEY=               # Notion integration token
GOOGLE_CALENDAR_CREDENTIALS=  # Google Calendar service account JSON path
GOOGLE_DRIVE_CREDENTIALS=     # Google Drive service account JSON path
JIRA_HOST=                    # Jira instance URL (https://your-domain.atlassian.net)
JIRA_EMAIL=                   # Jira account email
JIRA_API_TOKEN=               # Jira API token
CONFLUENCE_HOST=              # Confluence instance URL
CONFLUENCE_EMAIL=             # Confluence account email
CONFLUENCE_API_TOKEN=         # Confluence API token
TRELLO_API_KEY=               # Trello API key
TRELLO_TOKEN=                 # Trello API token

# ── Security ─────────────────────────────────────────────────────────────────────
HIBP_API_KEY=                 # Have I Been Pwned API key
VIRUSTOTAL_API_KEY=           # VirusTotal API key
SHODAN_API_KEY=               # Shodan API key

# ── Social ───────────────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=         # Twitter/X API bearer token
TWITTER_API_KEY=              # Twitter/X API key
TWITTER_API_SECRET=           # Twitter/X API secret
LINKEDIN_ACCESS_TOKEN=        # LinkedIn API access token
INSTAGRAM_ACCESS_TOKEN=       # Instagram API access token
MAILCHIMP_API_KEY=            # Mailchimp API key
HUBSPOT_ACCESS_TOKEN=         # HubSpot API access token

# ── Image & Video Generation (Mind's Eye) ─────────────────────────────────────────
# Default: Procedural Canvas (no key needed, generates SVGs)
# Set any of these for AI-powered generation:
OPENAI_API_KEY=               # DALL-E 3 image generation
STABILITY_API_KEY=            # Stability AI (SDXL, SD3)
REPLICATE_API_TOKEN=          # Replicate (SDXL, Flux, video models)

# ── GROQ (Primary LLM) ───────────────────────────────────────────────────────────
# Required for soul consciousness. Get at https://console.groq.com
GROQ_API_KEY=
